# Database
DATABASE_URL=postgresql://user:password@neon.tech/lefitness

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin
ADMIN_PASSWORD=lefitness-admin
ADMIN_SESSION_SECRET=change-me-admin-session-secret

# Google Calendar (optional — only needed for booking webhook)
# Service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Public URL that Google will POST webhook notifications to
GOOGLE_CALENDAR_WEBHOOK_URL=https://yourdomain.com/webhooks/calendar

# Meta/Facebook (optional — only needed for Messenger integration)
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Testing
USE_MOCK_APIS=false
TEST_MODE=false
